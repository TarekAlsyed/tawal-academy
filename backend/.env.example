# =================================================================
# Tawal Academy Backend — Environment Variables Template
# Copy this to .env and fill in your actual values
# =================================================================

# --- Server Configuration ---
NODE_ENV=production
IP=0.0.0.0
PORT=8100

# --- Database (Supabase) ---
DATABASE_URL=postgresql://user:password@host:5432/database
# Fix #13: CA certificate for production SSL verification (optional, base64-encoded)
DB_CA_CERT=

# --- Cloudinary ---
CLOUDINARY_URL=cloudinary://key:secret@cloud
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# --- App Settings ---
JWT_SECRET=your_jwt_secret_here
JWT_ACCESS_SECRET=your_access_secret_here
JWT_REFRESH_SECRET=your_refresh_secret_here
JWT_ADMIN_SECRET=your_admin_secret_here
FRONTEND_URL=https://yourdomain.github.io/tawal-academy
BACKEND_URL=https://your-backend.alwaysdata.net

# --- Security Keys ---
ENCRYPTION_KEY=your_64_hex_char_key_here
APP_SECRET=your_64_hex_char_key_here
APP_SIGNATURE=your_unique_app_signature
CSRF_SECRET=your_64_hex_char_key_here

# Fix #22: Admin Preview Key (moved from hardcoded to env var)
ADMIN_PREVIEW_KEY=your_preview_key_here

# Fix #9: Cookie domain for cross-origin production environments
COOKIE_DOMAIN=.alwaysdata.net

# --- OTP / Email ---
# Fix #34: Enable OTP for student login security
OTP_ENABLED=true
ADMIN_EMAIL=admin@yourdomain.com
SMTP_HOST=smtp.yourdomain.com
SMTP_PORT=587
SMTP_USER=noreply@yourdomain.com
SMTP_PASS=your_smtp_password_here

# --- Notifications & Alerts ---
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/xxx/xxx/xxx
SMS_API_KEY=your_sms_api_key
SMS_SENDER=TAWAL

# --- Feature Flags ---
STRICT_SECURITY_MODE=false
